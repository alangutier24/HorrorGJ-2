  m_Script: {fileID: 11500000, guid: 3b013548fcefd47878e33d3f05761195, type: 3}
  m_Name: Why
  m_EditorClassIdentifier: Assembly-CSharp::DialogueObject
  dialogue:
  - 'Because... the king told me to. '
  - Twelve years ago. He said "guard this until I return."
  - He went to get a sandwich.
  responses:
  - responseText: Has it occurred to you he's not coming back?
    dialogueObject: {fileID: 11400000, guid: ca3b5834d90a7447f8d02f8625fe58c4, type: 2}
  - responseText: Come with me instead!
    dialogueObject: {fileID: 11400000, guid: 8cdd95b2cf12443729c09e7f4b4849ff, type: 2}
